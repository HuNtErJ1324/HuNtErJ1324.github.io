# Copy to .env (git-ignored: it holds secrets) and fill in as README.md goes.

# The home server's Tailscale address (`tailscale ip -4`). Comentario's port is
# published only there.
TAILSCALE_IP=
# Port on that address; change it if something on the server already uses 8080
COMENTARIO_PORT=8080
# Comentario derives its signing key from this; generate with: openssl rand -hex 32
COMENTARIO_SIGNING_KEY=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel)
TUNNEL_TOKEN=

# Moderator
# Anthropic API key (console.anthropic.com → API keys); set a spend limit on it
ANTHROPIC_API_KEY=
# Signing secret Comentario shows once, when the webhook is created
WEBHOOK_SECRET=
# The Comentario user with the Moderator role on justin-chae.org
MODERATOR_EMAIL=
MODERATOR_PASSWORD=
# true: Claude's verdicts are logged and sent to ntfy, but nothing gets approved or
# rejected. Set to false once you trust them.
DRY_RUN=true
# Optional phone notifications: an ntfy topic URL, e.g. https://ntfy.sh/<long random name>
# (a public ntfy.sh topic is readable by anyone who guesses the name), plus an
# access token if the topic is protected.
NOTIFY_URL=
NOTIFY_TOKEN=
