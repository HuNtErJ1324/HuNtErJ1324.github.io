---
import Base from '../layouts/Base.astro';
---

<Base
	title="404 — not found"
	description="That path doesn't exist."
	canonical="/404.html"
	statuslinePath="~"
>
	<div class="error-page">
		<pre aria-hidden="true">
 _  _    ___  _  _
| || |  / _ \| || |
| || |_| | | | || |_
|__   _| | | |__   _|
   | |_| |_| |  | |
   |_(_)\___/   |_|
		</pre>
		<p class="error-cmd">bash: <span class="err-path">requested path</span>: No such file or directory</p>
		<p><a href="/">cd ~</a> &nbsp;·&nbsp; <a href="/blog/">cd ~/blog</a> &nbsp;·&nbsp; <a href="/music/">cd ~/violin</a></p>
	</div>
</Base>
