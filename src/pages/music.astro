---
import Base from '../layouts/Base.astro';

const performances = [
	{
		label: '2025 · meany hall',
		title: 'UWSO Concert (2025)',
		blurb: 'I played in 5th chair of the first violins! The concert was in Meany Hall. This is one of my favorite performances!',
		videoId: '-J_jHC2yaro',
		alt: 'UWSO Concert 2025 performance thumbnail'
	},
	{
		label: '2023 · summer recital',
		title: 'Senior Recital (2023)',
		blurb: "I performed a duet for my violin studio's summer recital as my last performance during high school!",
		videoId: 'D5TcV-GmLHA',
		alt: 'Senior Recital 2023 performance thumbnail'
	},
	{
		label: '2022 · benaroya hall',
		title: 'Youth Symphony Orchestra Concert (2022)',
		blurb: 'I played in 5th chair of the first violins during this Seattle Youth Symphony Orchestras concert at Benaroya Hall.',
		videoId: 'NRKfTdwxN-8',
		alt: 'Youth Symphony Orchestra Concert 2022 performance thumbnail'
	},
	{
		label: '2023 · state competition',
		title: 'Chamber Orchestra Washington State Competition (2023)',
		blurb: "I was the concertmaster of my high school's chamber orchestra and we got 3rd place at the state competition.",
		videoId: 'ILLMmiDS8S4',
		alt: 'Chamber Orchestra Washington State Competition 2023 performance thumbnail'
	},
	{
		label: '2023 · benaroya hall',
		title: 'Youth Symphony Orchestra Concert (2023)',
		blurb: 'I played in 8th chair of the first violins during this Seattle Youth Symphony Orchestras concert at Benaroya Hall. Enjoy the accompanying light show!',
		videoId: 'y2B5To-stB4',
		alt: 'Youth Symphony Orchestra Concert 2023 performance thumbnail'
	},
	{
		label: '2024 · meany hall',
		title: 'UWSO Concert (2024)',
		blurb: 'I played in 7th chair of the first violins during this University of Washington Symphony Orchestra concert at Meany Hall.',
		videoId: 'gfFdNoXpltA',
		alt: 'UWSO Concert 2024 performance thumbnail'
	},
	{
		label: '2022 · distinguished gold',
		title: 'Virtuoso Festival (2022)',
		titleHref: 'https://www.seattlepianocompetition.org/nw-festivals/winners/virtuoso-artists-22/',
		blurb: 'I received a distinguished gold medal in the Virtuoso Festival in the Concerto: Ages 14 to 18 division.',
		videoId: 'TUti6xJVE50',
		alt: 'Virtuoso Festival 2022 gold medal performance thumbnail'
	}
];
---

<Base
	title="Violin Performances | Justin Yang Chae"
	description="Collection of violin performances by Justin Yang Chae, including solos, duets, and orchestral works with University of Washington Symphony Orchestra"
	canonical="/music/"
	activeNavLink="violin"
	statuslinePath="~/violin"
>
	<header class="banner page-banner">
		<p class="boot-line" aria-hidden="true">justin@uw:~$ cat violin.log</p>
		<h1>Violin Performances</h1>
		<p>
			Here is a collection of performances I have participated in, including solos, duets, and works with the
			University of Washington Symphony Orchestra, Inglemoor High School Chamber Orchestra, and the
			Youth Symphony Orchestra in the Seattle Youth Symphony Orchestras.
		</p>
	</header>
	{performances.map((p) => (
		<section data-label={p.label}>
			<h2>
				{p.titleHref
					? <a href={p.titleHref} target="_blank" rel="noopener noreferrer">{p.title}</a>
					: p.title}
			</h2>
			<p>{p.blurb}</p>
			<div>
				<div class="video-container">
					<div class="video-placeholder" data-video-id={p.videoId}>
						<img src={`https://img.youtube.com/vi/${p.videoId}/hqdefault.jpg`} alt={p.alt} loading="lazy" width="480" height="360">
						<button class="play-button" aria-label="Play Video">▶ Play</button>
					</div>
				</div>
			</div>
		</section>
	))}
</Base>
