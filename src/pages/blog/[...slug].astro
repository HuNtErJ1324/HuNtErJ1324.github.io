---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, readingMinutes, relatedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			previous: posts[i + 1] ?? null,
			next: posts[i - 1] ?? null,
			related: relatedPosts(post, posts)
		}
	}));
}

const { post, previous, next, related } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<Post
	post={post}
	minutes={readingMinutes(post)}
	hasMath={Boolean(remarkPluginFrontmatter?.hasMath)}
	previous={previous}
	next={next}
	related={related}
>
	<Content />
</Post>
