---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/posts';

export async function getStaticPaths() {
	const all = await getPosts();
	const tags = new Set(all.flatMap((post) => post.data.tags));
	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: all.filter((post) => post.data.tags.includes(tag))
		}
	}));
}

const { tag, posts } = Astro.props;
---

<Base
	title={`#${tag} | Justin Yang Chae`}
	description={`Posts tagged ${tag} on justin-chae.org`}
	canonical={`/blog/tag/${tag}/`}
	statuslinePath={`~/blog/tag/${tag}`}
	activeNavLink="blog"
>
	<header class="banner page-banner">
		<p class="boot-line" aria-hidden="true">justin@uw:~$ grep -l '#{tag}' ~/blog/*.md</p>
		<h1>#{tag}</h1>
		<p>
			Posts tagged <strong>{tag}</strong> — <a href="/blog/">[ all posts ]</a>
		</p>
	</header>
	<section data-label={`~/blog/tag/${tag}`}>
		<h2>Posts</h2>
		<p class="listing-meta">total {posts.length}</p>
		<PostList posts={posts} />
	</section>
</Base>
