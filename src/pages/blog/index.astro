---
import Base from '../../layouts/Base.astro';
import { getPosts, isDraft } from '../../lib/posts';

const posts = await getPosts();
---

<Base
	title="Blog | Justin Yang Chae"
	description="Notes on machine learning, math, music, and whatever else I'm thinking about."
	canonical="/blog/"
	statuslinePath="~/blog"
	activeNavLink="blog"
>
	<header class="banner page-banner">
		<p class="boot-line" aria-hidden="true">justin@uw:~$ ls ~/blog</p>
		<h1>Blog</h1>
		<p>
			Notes on machine learning, math, music, and whatever else I'm thinking about.
		</p>
	</header>
	<section data-label="~/blog/">
		<h2>Posts</h2>
		{posts.length > 0 ? (
			<>
				<p class="listing-meta">total {posts.length}</p>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							{(isDraft(post) || post.data.category || post.data.tags.length > 0) && (
								<div class="entry-meta">
									{isDraft(post) && <span class="chip chip-draft">draft</span>}
									{post.data.category && <span class="chip">{post.data.category}</span>}
									{post.data.tags.map((tag) => (
										<a class="chip chip-tag" href={`/blog/tag/${tag}/`}>{tag}</a>
									))}
								</div>
							)}
							<time class="post-date" datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
							<a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p class="post-excerpt">{post.data.description}</p>
						</li>
					))}
				</ul>
			</>
		) : (
			<p class="listing-meta">total 0 — nothing here yet. check back soon.</p>
		)}
	</section>
</Base>
