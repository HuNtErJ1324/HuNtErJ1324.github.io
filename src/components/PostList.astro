---
// Post listing used by the blog index and the tag pages.
import PostChips from './PostChips.astro';
import { formatDate, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{posts.map((post) => (
		<li>
			<div class="entry-meta">
				<time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				<PostChips post={post} />
			</div>
			<a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
			<p class="post-excerpt">{post.data.description}</p>
		</li>
	))}
</ul>
