---
// Switches between a post and its agent traces (src/lib/traces.ts): a row at
// the top of each trace page with "traces" (the index) and a pill per run, the
// current one marked, plus a link back; on the post it's a callout box under
// the date, "Read the agent traces →" and the same pills.
// The post's URL is only known once it's published (or under `astro dev`).
// Before that, the shared draft link must not go into these public pages, so
// the link reads "← blog" (the index), the post marks its row with
// data-trace-home, and script.js §14 remembers the page in the reader's
// browser; on the trace pages it then turns the link into "← the post".
import { TRACE_POSTS, traceRuns } from '../lib/traces';

interface Props {
	post: string;
	// A run id, 'index', or nothing (on the post)
	current?: string;
	// Where "← the post" goes; null falls back to "← blog" until script.js
	// finds the page the reader came from
	postHref?: string | null;
	onPost?: boolean;
}

const { post, current, postHref = null, onPost = false } = Astro.props;
const runs = traceRuns(post);
---

<nav
	class={`trace-switch${onPost ? ' ts-on-post' : ''}`}
	aria-label={`${TRACE_POSTS[post].title}: post and traces`}
	data-trace-post={post}
	data-trace-home={onPost ? '' : undefined}
>
	{!onPost && (
		<a class="ts-back" href={postHref ?? '/blog/'} data-trace-back={postHref ? undefined : ''}>{postHref ? '← the post' : '← blog'}</a>
	)}
	<a class="ts-label" href={`/traces/${post}/`} aria-current={current === 'index' ? 'page' : undefined}>{onPost ? 'Read the agent traces →' : 'traces'}</a>
	{runs.map((run) => (
		<a class={`tv-run c-${run.color}`} href={`/traces/${post}/${run.id}/`} aria-current={run.id === current ? 'page' : undefined}>
			<img src={run.logo} alt="" width="20" height="20" />{run.name}
		</a>
	))}
</nav>
