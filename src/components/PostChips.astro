---
// Draft / category / tag chips, shared by the blog index, tag pages, and the
// post header. Tag chips link to /blog/tag/<tag>/.
import { isDraft, type Post } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

{isDraft(post) && <span class="chip chip-draft">draft</span>}
{post.data.category && <span class="chip">{post.data.category}</span>}
{post.data.tags.map((tag) => (
	<>{' '}<a class="chip chip-tag" href={`/blog/tag/${tag}/`}>{tag}</a></>
))}
