---
// Animated replay of one agent's PretrainGym run, built from its self_score
// history (src/data/pretraingym.json → replay.<agent>). Left: validation loss
// by agent turn, where each job's dot appears at the turn its result came
// back (filled = full 400M
// budget, hollow = a cheaper probe) and a dashed line tracks the best
// full-budget result. Right: the mixture of the job that is running, then its
// result, ending on the submitted mixture and its test loss. Below: the
// phases of the run, highlighted in step.
//
// It reuses SelfPlayAnimation's clock (public/script.js §12): data-on/off,
// data-active and a data-travel playhead, with turns mapped linearly to
// seconds (so long waits on a job don't stretch the replay, but busy stretches
// of tool calls do); the .sp-scrub slider lets readers drag to any point,
// [speed] steps the pace through 0.5×–4×, and .sp-time reads the clock back
// as a turn. Without JS or under
// prefers-reduced-motion it is a static chart:
// every dot, the final best line, and the submitted mixture. Like
// <LineChart full>, it ships a 720-unit drawing and a compact one for phones.
import { type ChartColor, chartId, r1 } from '../../lib/charts';

type Row = [string, number, string];
// start/end are agent turns (launch, and the turn its result came back);
// hourStart/hourEnd are the same moments in wall-clock hours
interface Job {
	start: number;
	end: number;
	hourStart: number;
	hourEnd: number;
	budget: string;
	full: boolean;
	loss: number;
	rows: Row[];
}
interface Phase {
	from: number;
	to: number;
	name: string;
	text: string;
}
interface Props {
	name: string;
	color: ChartColor;
	data: { hours: number; turns: number; jobs: Job[]; submitted: { rows: Row[]; test: number } };
	phases: Phase[];
	xMax: number;
	xTicks: number[];
	// Seconds per loop; turns map linearly onto it
	cycle?: number;
	caption?: string;
}

const { name, color, data, phases, xMax, xTicks, cycle = 24, caption } = Astro.props;
const id = chartId('replay');
const { hours, turns: T, jobs, submitted } = data;

const Y = { min: 3.1, max: 3.9, ticks: [3.1, 3.3, 3.5, 3.7, 3.9] };
// 0.5 s lead-in; the run ends with ~4.5 s left to read the submitted mixture
const k = (cycle - 5) / T;
const t = (turn: number) => r1(0.5 + turn * k);
const tEnd = r1(t(T) + 1.2);
// Off-scale probes (GLM-5.3's 655K-token runs sit near 10.4) share one
// label, beside the last of them
const lastOff = jobs.map((j) => j.loss > 3.9).lastIndexOf(true);

// Best full-budget validation loss so far, and when it changed
const bests: { loss: number; on: number; off: number }[] = [];
jobs.forEach((j) => {
	if (!j.full || (bests.length && j.loss >= bests[bests.length - 1].loss)) return;
	if (bests.length) bests[bests.length - 1].off = t(j.end);
	bests.push({ loss: j.loss, on: t(j.end), off: cycle });
});

const frames = [
	...jobs.map((j, i) => ({
		on: t(j.start),
		off: i + 1 < jobs.length ? t(jobs[i + 1].start) : tEnd,
		head: `JOB ${i + 1} · ${j.budget} TOKENS`,
		sub: `launched at turn ${j.start} · hour ${j.hourStart.toFixed(1)}`,
		rows: j.rows,
		running: [t(j.start), t(j.end)] as [number, number],
		result: `val loss ${j.loss.toFixed(4)}`,
		resultOn: t(j.end),
		final: false
	})),
	{
		on: tEnd,
		off: cycle,
		head: 'SUBMITTED',
		sub: 'scored on the held-out test split',
		rows: submitted.rows,
		running: null,
		result: `test loss ${submitted.test.toFixed(4)}`,
		resultOn: tEnd,
		final: true
	}
];

const layouts = [
	{
		variant: 'chart-svg-full',
		W: 720,
		H: 316,
		plot: { l: 46, r: 440, t: 40, b: 264 },
		legendY: 18,
		panel: { x: 478, headY: 18, subY: 34, rowY: 66, rowH: 26, barX: 598, barW: 84, resultY: 248 }
	},
	{
		variant: 'chart-svg-compact',
		W: 330,
		H: 458,
		plot: { l: 40, r: 318, t: 36, b: 206 },
		legendY: 14,
		panel: { x: 8, headY: 272, subY: 288, rowY: 314, rowH: 22, barX: 150, barW: 120, resultY: 448 }
	}
];

const fmtLoss = (v: number) => v.toFixed(v >= 10 ? 1 : 4);
const nFull = jobs.filter((j) => j.full).length;
const desc = `A replay of ${name}'s run. Over ${T} turns (${hours.toFixed(1)} hours) it ran ${jobs.length} self_score jobs, ${nFull} of them at the full 400M-token budget. Its best full-budget validation loss was ${Math.min(...jobs.filter((j) => j.full).map((j) => j.loss)).toFixed(4)}, and its submitted mixture (${submitted.rows.map((r) => `${r[0]} ${r[2]}`).join(', ')}) scored a test loss of ${submitted.test.toFixed(4)}.`;
---

<figure class={`chart chart-full sp-anim ar-anim c-${color}`} data-cycle={cycle}>
	<div class="chart-head">
		<p class="chart-title" id={`${id}-title`}>{name}'s run, replayed</p>
		<p class="chart-sub">Each dot is a self_score job, placed at the agent turn its result came back; the panel shows that job's mixture.</p>
	</div>
	<p class="visually-hidden" id={`${id}-desc`}>{desc}</p>
	{layouts.map((L) => {
		const { l, r, t: top, b } = L.plot;
		const sx = (turn: number) => l + (turn / xMax) * (r - l);
		const sy = (v: number) => b - ((Math.min(v, Y.max) - Y.min) / (Y.max - Y.min)) * (b - top);
		const P = L.panel;
		const barW = (v: number) => Math.max(1.5, (v / 100) * P.barW);
		return (
			<svg class={`chart-svg ${L.variant}`} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-title`} aria-describedby={`${id}-desc`}>
				<g class="ar-legend" aria-hidden="true">
					<circle class="ar-dot" cx={l + 4} cy={L.legendY - 4} r="4" />
					<text x={l + 13} y={L.legendY}>400M run</text>
					<circle class="ar-dot ar-probe" cx={l + 84} cy={L.legendY - 4} r="3.6" />
					<text x={l + 93} y={L.legendY}>cheaper probe</text>
					<path class="ar-test" d={`M${l + 196} ${L.legendY - 9}l5 5l-5 5l-5 -5Z`} />
					<text x={l + 206} y={L.legendY}>test</text>
				</g>

				<g class="chart-grid">
					{Y.ticks.map((v) => <line x1={l} x2={r} y1={r1(sy(v))} y2={r1(sy(v))} />)}
				</g>
				<line class="chart-axis" x1={l} x2={r} y1={b} y2={b} />
				<g class="chart-ticks">
					{Y.ticks.map((v) => <text x={l - 7} y={r1(sy(v)) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
					{xTicks.map((h) => (
						<>
							<line class="chart-tick" x1={r1(sx(h))} x2={r1(sx(h))} y1={b} y2={b + 4} />
							<text x={r1(sx(h))} y={b + 17} text-anchor="middle">{h}</text>
						</>
					))}
				</g>
				<text class="chart-axis-label" x={(l + r) / 2} y={b + 34} text-anchor="middle">agent turns</text>
				<text class="chart-axis-label" x={l - 40} y={top - 6}>val loss</text>

				<g class="sp-packet ar-playhead" transform={`translate(${r1(sx(0))} 0)`} data-travel={`${t(0)} ${t(T)}`} data-route={`${r1(sx(0))} 0 ${r1(sx(T))} 0`} data-ease="linear" aria-hidden="true">
					<line x1="0" x2="0" y1={top} y2={b} />
				</g>

				{bests.map((s, i) => (
					<g class={`ar-best${i === bests.length - 1 ? ' ar-final' : ''}`} data-on={s.on} data-off={s.off}>
						<line x1={l} x2={r} y1={r1(sy(s.loss))} y2={r1(sy(s.loss))} />
						<text x={l + 5} y={r1(sy(s.loss)) - 5}>best {s.loss.toFixed(4)}</text>
					</g>
				))}

				{jobs.map((j, i) => (
					<g data-on={t(j.end)}>
						<circle class={`ar-dot${j.full ? '' : ' ar-probe'}`} cx={r1(sx(j.end))} cy={r1(sy(j.loss))} r={j.full ? 4.5 : 3.8}>
							<title>{`Job ${i + 1} · ${j.budget} tokens · result at turn ${j.end} (hour ${j.hourEnd.toFixed(1)}) · val loss ${fmtLoss(j.loss)}`}</title>
						</circle>
						{i === lastOff && (
							<text class="ar-offscale" x={r1(sx(j.end)) + 7} y={r1(sy(j.loss)) + 4}>↑{fmtLoss(j.loss)}</text>
						)}
					</g>
				))}

				<g data-on={tEnd}>
					<path class="ar-test" d={`M${r1(sx(T))} ${r1(sy(submitted.test)) - 6}l6 6l-6 6l-6 -6Z`}>
						<title>{`Final test loss ${submitted.test.toFixed(4)}`}</title>
					</path>
					<text class="ar-test-label" x={r1(sx(T)) + 6} y={r1(sy(submitted.test)) - 11} text-anchor="end">test {submitted.test.toFixed(4)}</text>
				</g>

				{frames.map((f) => (
					<g class={`ar-frame${f.final ? ' ar-final' : ''}`} data-on={f.on} data-off={f.off}>
						<text class="ar-head" x={P.x} y={P.headY}>{f.head}</text>
						<text class="ar-sub" x={P.x} y={P.subY}>{f.sub}</text>
						{f.rows.map(([label, value, pct], ri) => {
							const y = P.rowY + ri * P.rowH;
							return (
								<g>
									<text class="ar-label" x={P.x} y={y}>{label}</text>
									<rect class="chart-track" x={P.barX} y={y - 9} width={P.barW} height="10" rx="2" />
									<rect class="ar-bar" x={P.barX} y={y - 9} width={r1(barW(value))} height="10" rx="2" />
									<text class="ar-pct" x={r1(P.barX + barW(value) + 5)} y={y}>{pct}</text>
								</g>
							);
						})}
						{f.running && (
							<text class="ar-running" x={P.x} y={P.resultY} data-on={f.running[0]} data-off={f.running[1]}>training…</text>
						)}
						<text class="ar-result" x={P.x} y={P.resultY} data-on={f.resultOn} data-off={f.off}>{f.result}</text>
					</g>
				))}
			</svg>
		);
	})}
	<div class="sp-controls" hidden>
		<button type="button" class="sp-btn" data-sp="toggle" aria-label="Pause animation">[pause]</button>
		<button type="button" class="sp-btn" data-sp="restart" aria-label="Restart animation">[restart]</button>
		<button type="button" class="sp-btn" data-sp="speed" aria-label="Playback speed 1×; change speed">[speed 1×]</button>
		<input type="range" class="sp-scrub" min="0" max={cycle} step="any" value="0" aria-label={`Replay position in ${name}'s run`} />
		<span class="sp-time" data-offset="0.5" data-rate={k} data-max={T} data-unit="turn" data-digits="0" aria-hidden="true">turn 0</span>
	</div>
	<ol class="sp-steps">
		{phases.map((p, i) => (
			<li data-active={`${t(p.from)} ${i === phases.length - 1 ? cycle : t(p.to)}`}><strong>{p.name}</strong> {p.text}</li>
		))}
	</ol>
	{(caption || Astro.slots.has('default')) && (
		<figcaption>{caption}<slot /></figcaption>
	)}
</figure>
