---
// One message from an agent trace, styled like a chat app: an assistant
// message gets an avatar (`avatar`, a local copy of the lab's logo under
// public/assets/blog/, ringed in the model's chart hue; without it, the
// name's first letter on that hue), a name line and a bubble;
// a user message is a right-aligned bubble; a tool message is a compact
// call/result row aligned under the assistant's bubble. The body goes in the
// slot as ordinary markdown. Wrap consecutive messages in <Chat> to stack
// them as one exchange with a single caption. `trace` links the message to
// where it happens in the full trace (a /traces/<post>/<run>/#turn-N URL).
interface Props {
	role?: 'assistant' | 'user' | 'tool';
	name?: string;
	meta?: string;
	color?: 'love' | 'blue' | 'gold' | 'iris' | 'rose' | 'gray';
	avatar?: string;
	tool?: string;
	trace?: string;
}

const { role = 'assistant', name = '', meta, color = 'iris', avatar, tool, trace } = Astro.props;
const body = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';
---

{role === 'assistant' && (
	<div class="chat-msg chat-assistant">
		{avatar ? (
			<img class={`chat-avatar chat-avatar-img c-${color}`} src={avatar} alt="" width="30" height="30" loading="lazy" decoding="async" />
		) : (
			<span class={`chat-avatar c-${color}`} aria-hidden="true">{name.charAt(0)}</span>
		)}
		<div class="chat-col">
			{name && (
				<p class="chat-who">
					<span class="chat-name">{name}</span>
					{meta && <span class="chat-meta">{meta}</span>}
					{trace && <a class="chat-trace" href={trace}>in the trace →</a>}
				</p>
			)}
			<div class="chat-bubble"><Fragment set:html={body} /></div>
		</div>
	</div>
)}
{role === 'user' && (
	<div class="chat-msg chat-user">
		<div class="chat-bubble"><Fragment set:html={body} /></div>
	</div>
)}
{role === 'tool' && (
	<div class="chat-msg chat-tool">
		<div class="chat-call">
			{tool && <span class="chat-tool-name">{tool}</span>}
			<div class="chat-call-body"><Fragment set:html={body} /></div>
			{trace && <a class="chat-trace" href={trace}>in the trace →</a>}
		</div>
	</div>
)}
