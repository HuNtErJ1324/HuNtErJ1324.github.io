---
// Post layout — ported from the Jekyll post layout, plus the related-posts
// aside the general post anatomy calls for and giscus comments. MathJax loads
// only on posts that contain math (hasMath, set by remark-mathjax). `shared`
// renders a draft at its /drafts/<token>/ link: noindex, no canonical URL.
// A post with at least three h2/h3 headings gets a table of contents in the
// left gutter on wide screens (script.js §13 marks the section being read).
// A post with published agent traces (src/lib/traces.ts) links to them at the
// top, under the date.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import PostChips from '../components/PostChips.astro';
import TraceSwitch from '../components/TraceSwitch.astro';
import { giscus } from '../lib/giscus';
import { formatDate, isDraft, type Post } from '../lib/posts';
import { TRACE_POSTS } from '../lib/traces';
import { assetVersion } from '../lib/site';

interface Props {
	post: Post;
	minutes: number;
	hasMath: boolean;
	previous: Post | null;
	next: Post | null;
	related: Post[];
	headings?: MarkdownHeading[];
	shared?: boolean;
}

const { post, minutes, hasMath, previous, next, related, headings = [], shared = false } = Astro.props;
// Sections and subsections only; remark-gfm's "Footnotes" heading isn't one
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const { date, title, description } = post.data;
const dateIso = date.toISOString();
const draft = isDraft(post);
const showComments = !draft && post.data.comments;
const shareToken = post.collection === 'drafts' ? post.data.share : undefined;
// giscus loads the theme from inside its iframe, so it gets the absolute
// production URL (also in dev), versioned like home.css to beat Cloudflare's cache
const giscusTheme = new URL(`/assets/giscus-rose-pine.css${assetVersion}`, Astro.site).href;
// Pin the thread key and the discussion's backlink to the canonical URL, so
// /index.html, query strings, or localhost previews never fork or mislabel a thread.
// The term matches what pathname mapping produces for /blog/<slug>/.
const giscusTerm = `blog/${post.id}/`;
const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const fileName = post.filePath?.split('/').pop() ?? `${post.id}.md`;
---

<Base
	title={`${title} | Justin Yang Chae`}
	description={description}
	canonical={shared ? undefined : `/blog/${post.id}/`}
	noindex={shared}
	statuslinePath="~/blog"
	csp="post"
	comments={showComments}
	ogType="article"
	publishedTime={shared ? undefined : dateIso}
	activeNavLink="blog"
>
	<Fragment slot="head">
		{hasMath && (
			<>
				{/* Math rendering: self-hosted MathJax 3 (SVG), config first, then the bundle */}
				<script is:inline src="/assets/mathjax-config.js"></script>
				<script is:inline src="/assets/mathjax/tex-svg.js" id="MathJax-script" async></script>
			</>
		)}
		{showComments && <meta name="giscus:backlink" content={canonicalUrl}>}
	</Fragment>
	<header class="banner page-banner">
		<p class="boot-line" aria-hidden="true">justin@uw:~/blog$ cat {fileName}</p>
	</header>
	<article class="post">
		{toc.length >= 3 && (
			<nav class="post-toc" aria-labelledby="toc-title">
				<div class="toc-inner">
					<p class="toc-title" id="toc-title">contents</p>
					<ol>
						{toc.map((h) => (
							<li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
						))}
					</ol>
				</div>
			</nav>
		)}
		<header class="post-header">
			<h1>{title}</h1>
			<p class="post-meta">
				<PostChips post={post} linkTags={!shared} />
				<span class="post-when">
					<time class="post-date" datetime={dateIso}>{formatDate(date)}</time>
					<span class="meta-sep" aria-hidden="true">&middot;</span>
					<span>{minutes} min read</span>
				</span>
			</p>
			{post.id in TRACE_POSTS && <TraceSwitch post={post.id} onPost />}
			{draft && (shared ? (
				<p class="draft-note">
					Unpublished draft, shared by link. It isn't listed on this site yet.
				</p>
			) : (
				<p class="draft-note">
					Draft — only visible under <code>npm run dev</code>. Publish with
					<code>npm run draft:publish -- {post.id}</code>.
					{shareToken && <>Shared by link at <a href={`/drafts/${shareToken}/`}>/drafts/{shareToken}/</a>.</>}
				</p>
			))}
		</header>
		<div class="post-content">
			<slot />
		</div>
		<nav class="post-nav" aria-label="Post navigation">
			{previous
				? <a href={`/blog/${previous.id}/`}>&larr; older</a>
				: <span>&larr; older</span>}
			<a href="/blog/">[ index ]</a>
			{next
				? <a href={`/blog/${next.id}/`}>newer &rarr;</a>
				: <span>newer &rarr;</span>}
		</nav>
		{related.length > 0 && (
			<aside class="related-posts" aria-label="Related posts">
				<h2>related posts</h2>
				<ul class="post-list">
					{related.map((p) => (
						<li>
							<time class="post-date" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
							<a class="post-title" href={`/blog/${p.id}/`}>{p.data.title}</a>
							<p class="post-excerpt">{p.data.description}</p>
						</li>
					))}
				</ul>
			</aside>
		)}
	</article>
	{showComments && (
		<section class="post-comments" id="comments" data-label="~/comments" aria-labelledby="comments-heading">
			<h2 id="comments-heading">Comments</h2>
			<!-- script.js loads giscus here once the panel nears the viewport -->
			<!-- The id makes giscus's GitHub sign-in return to #giscus-thread -->
			<div
				class="giscus"
				id="giscus-thread"
				data-repo={giscus.repo}
				data-repo-id={giscus.repoId}
				data-category={giscus.category}
				data-category-id={giscus.categoryId}
				data-mapping="specific"
				data-term={giscusTerm}
				data-strict="1"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="top"
				data-lang="en"
				data-theme={giscusTheme}
			></div>
			<p class="comments-fallback">
				Comments run on <a href="https://giscus.app" target="_blank" rel="noopener noreferrer">giscus</a> (GitHub
				Discussions): sign in with GitHub to comment, reply, or upvote with &#128077;. You can also
				<a href={giscus.discussionsUrl} target="_blank" rel="noopener noreferrer">join the discussion on GitHub</a>.
			</p>
		</section>
	)}
</Base>
