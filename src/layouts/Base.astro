---
// Shared chrome for every page (originally ported from the Jekyll default layout).
// CSP note: 'post' pages allow style-src 'unsafe-inline' (MathJax SVG styles
// and Shiki's inline token colors); posts with comments also allow the comment
// server (src/lib/comments.ts) for its script, comentario.css, avatars, API
// calls, and live-update WebSocket, plus data: images (the widget's CSS icons).
// font-src lists it too: no font is fetched (no-fonts), but Chrome logs a
// violation for every @font-face in comentario.css when the origin is missing.
// Every other page stays strict.
import { comments as commentServer } from '../lib/comments';
import { assetVersion } from '../lib/site';

interface Props {
	title: string;
	description: string;
	// Site-relative path; omit on pages that should not be indexed (with noindex)
	canonical?: string;
	noindex?: boolean;
	statuslinePath?: string;
	csp?: 'strict' | 'post';
	comments?: boolean;
	ogType?: 'website' | 'article';
	ogImage?: string;
	// Describes a page's own preview image (read out where the card shows)
	ogImageAlt?: string;
	publishedTime?: string;
	activeNavLink?: 'home' | 'violin' | 'blog' | 'tools';
}

const {
	title,
	description,
	canonical,
	noindex = false,
	statuslinePath = '~/portfolio',
	csp = 'strict',
	comments = false,
	ogType = 'website',
	ogImage = '/assets/profile_photo.jpg',
	ogImageAlt,
	publishedTime,
	activeNavLink
} = Astro.props;

const withComments = csp === 'post' && comments;
const commentsSrc = withComments ? ` ${commentServer.origin}` : '';
const commentsImg = withComments ? ` ${commentServer.origin} data:` : '';
const commentsConnect = withComments ? ` ${commentServer.origin} ${commentServer.socketOrigin}` : '';
const cspContent =
	csp === 'post'
		? `default-src 'self'; script-src 'self'${commentsSrc}; style-src 'self' 'unsafe-inline'${commentsSrc}; font-src 'self'${commentsSrc}; img-src 'self' https://img.youtube.com${commentsImg}; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://platform.twitter.com https://twitter.com https://x.com; connect-src 'self'${commentsConnect}; object-src 'none'; base-uri 'self'; form-action 'self'`
		: "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' https://img.youtube.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'";

const absolute = (path: string) => new URL(path, Astro.site).href;
const year = new Date().getFullYear();
type NavKey = NonNullable<Props['activeNavLink']>;
const linkClass = (key: NavKey) => (activeNavLink === key ? 'active' : undefined);
const linkCurrent = (key: NavKey) => (activeNavLink === key ? ('page' as const) : undefined);
---

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="Content-Security-Policy" content={cspContent}>
	<title>{title}</title>
	<meta name="description" content={description}>
	<meta name="author" content="Justin Yang Chae">
	<meta name="theme-color" content="#191724">
	{noindex && <meta name="robots" content="noindex">}

	<!-- Open Graph / Social Media -->
	<meta property="og:title" content={title}>
	<meta property="og:description" content={description}>
	<meta property="og:image" content={absolute(ogImage)}>
	{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt}>}
	{canonical && <meta property="og:url" content={absolute(canonical)}>}
	<meta property="og:type" content={ogType}>
	<meta property="og:site_name" content="Justin Yang Chae">
	{publishedTime && <meta property="article:published_time" content={publishedTime} />}

	<!-- Twitter Card -->
	{/* A page with its own preview image gets the large card; an article
	     without one keeps the small square for the profile photo */}
	<meta name="twitter:card" content={Astro.props.ogImage || ogType !== 'article' ? 'summary_large_image' : 'summary'}>
	<meta name="twitter:title" content={title}>
	<meta name="twitter:description" content={description}>
	<meta name="twitter:image" content={absolute(ogImage)}>
	{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt}>}

	{canonical && <link rel="canonical" href={absolute(canonical)}>}

	<link rel="stylesheet" href={`/home.css${assetVersion}`}>
	<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
	<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
	<link rel="shortcut icon" href="/assets/favicon.ico">

	<slot name="head" />
</head>

<body>
	<a href="#main" class="skip-link">Skip to content</a>
	<nav class="site-nav" aria-label="Main navigation">
		<a href="/" class={linkClass('home')} aria-current={linkCurrent('home')}>Home</a>
		<a href="/music/" class={linkClass('violin')} aria-current={linkCurrent('violin')}>Violin</a>
		<a href="/blog/" class={linkClass('blog')} aria-current={linkCurrent('blog')}>Blog</a>
		<a href="/tools/" class={linkClass('tools')} aria-current={linkCurrent('tools')}>Tools</a>
	</nav>
	<main id="main">
		<slot />
	</main>
	<footer class="statusline">
		<span class="statusline-mode" aria-hidden="true">NORMAL</span>
		<span class="statusline-path">justin@justin-chae.org:{statuslinePath}</span>
		<span class="statusline-spacer" aria-hidden="true"></span>
		<span class="statusline-copy">&copy; {year} Justin Yang Chae</span>
		<span class="statusline-hint" aria-hidden="true">? help</span>
		<span class="statusline-cmd" id="showcmd" aria-hidden="true"></span>
		<span class="statusline-pct" id="scroll-pct" aria-hidden="true">0%</span>
	</footer>
	<button id="back-to-top" type="button" aria-label="Back to top">[ &uarr; top ]</button>
	<script is:inline src={`/script.js${assetVersion}`}></script>
</body>

</html>
